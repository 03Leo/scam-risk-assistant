# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/

# ── Raw & Processed Data ──────────────────────────────────────
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Trained model artifacts ───────────────────────────────────
# Track pre-trained baseline model (2.2 MB) for instant zero-setup app launch
models/*
!models/.gitkeep
!models/scam_risk_model.joblib

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
